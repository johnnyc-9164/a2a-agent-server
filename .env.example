# Public base URL of this deployment (no trailing slash).
# Used in the agent card and supportedInterfaces. Local dev falls back to the request origin.
PUBLIC_BASE_URL=http://localhost:3000

# Optional: Upstash Redis (REST) for durable task storage. When both are set,
# tasks persist across serverless instances; otherwise the server uses an
# in-memory store (local dev default).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
