# Public base URL of this deployment (no trailing slash).
# Used in the agent card and supportedInterfaces. Local dev falls back to the request origin.
PUBLIC_BASE_URL=http://localhost:3000

# Optional: Vercel Blob for durable task storage. When set, tasks persist
# across serverless instances (one JSON blob per task under tasks/<id>.json);
# otherwise the server uses an in-memory store (local dev default).
# The token is injected automatically when the Blob store is connected to the
# Vercel project — never commit a real value here.
# BLOB_READ_WRITE_TOKEN=
